---
import LoginForm from '@/components/administration/users/LoginForm'
import Footer from '@/components/core/Footer.astro'
import Header from '@/components/core/Header.astro'
import Layout from '@/layouts/Layout.astro'

const refreshToken = Astro.cookies.get('refreshToken')?.value

if (refreshToken) return Astro.redirect('/administration/dashboard')

export const prerender = false
---

<Layout
  title="Iniciar sesión"
  description="Inicio de sesión de editores y administradores"
>
  <Header />
  <main id="login-container" class="grid h-8/12 place-items-center">
    <h1 class="text-ule my-8 text-center text-4xl font-bold">Iniciar sesión</h1>
    <LoginForm client:load />
  </main>
  <Footer />
</Layout>
