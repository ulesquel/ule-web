---
import UsersTable from '@/components/administration/users/UsersTable.astro'
import Footer from '@/components/core/Footer.astro'
import Header from '@/components/core/Header.astro'
import Layout from '@/layouts/Layout.astro'
import type { Fest, FetchError, FetchSuccess, UserData } from '@/types/types'
import type { AstroCookieSetOptions } from 'astro'

const api = import.meta.env.API_URL
const nodeEnv = import.meta.env.NODE_ENV

const refreshToken = Astro.cookies.get('refreshToken')?.value ?? ''
const accessToken = Astro.cookies.get('accessToken')?.value ?? ''
const accessTokenCookieOptions: AstroCookieSetOptions = {
  httpOnly: true,
  sameSite: 'lax',
  maxAge: 15 * 60,
  secure: nodeEnv === 'production',
  path: '/',
}
const refreshTokenCookieOptions: AstroCookieSetOptions = {
  httpOnly: true,
  sameSite: 'lax',
  maxAge: 7 * 24 * 60 * 60,
  secure: nodeEnv === 'production',
  path: '/',
}

const redirectionPath = '/administration'
if (!refreshToken) return Astro.redirect(redirectionPath)

const deleteAllCookies = () => {
  Astro.cookies.delete('refreshToken', refreshTokenCookieOptions)
  Astro.cookies.delete('accessToken', accessTokenCookieOptions)
}

const getData = async <T extends any>(
  endpoint: string,
): Promise<FetchError | FetchSuccess<T>> => {
  try {
    const res = await fetch(`${api}${endpoint}`, {
      method: 'get',
      headers: {
        Cookie: `refreshToken=${refreshToken}`,
        Authorization: `Bearer ${accessToken}`,
      },
      credentials: 'include',
    })

    if (res.status === 423) {
      const { message } = await res.json()
      deleteAllCookies()
      return {
        status: 'error',
        error: {
          message,
        },
        code: res.status,
      } as FetchError
    }

    if (res.status >= 300) {
      const { message } = await res.json()
      return {
        status: 'error',
        error: {
          message,
        },
        code: res.status,
      } as FetchError
    }
    const data = await res.json()
    return { status: 'success', data } as FetchSuccess<T>
  } catch (error) {
    console.log(error)
    return {
      status: 'error',
      error: {
        message:
          'Un error inesperado ha ocurrido. Estamos trabajando para solucionarlo.',
      },
    } as FetchError
  }
}

const [userRes, festRes, allUserRes] = await Promise.all([
  getData<Omit<UserData, 'id_user'>>('users/dashboard/'),
  getData<Fest[]>('fests/'),
  getData<UserData[]>('users/'),
])

if (userRes.status === 'error') {
  if (userRes.code === 302) {
    return Astro.redirect(redirectionPath)
  }
}

if (allUserRes.status === 'error') {
  if (allUserRes.code === 418) {
    Astro.cookies.delete('refreshToken')
    Astro.cookies.delete('accessToken')
    await fetch(`${api}users/refresh`, {
      method: 'get',
      headers: {
        Cookie: `refreshToken=${refreshToken}`,
      },
      credentials: 'include',
    })
      .then((res) => {
        return res.json()
      })
      .then((data) => {
        const { refreshToken, accessToken } = data
        Astro.cookies.set('accessToken', accessToken, accessTokenCookieOptions)
        Astro.cookies.set(
          'refreshToken',
          refreshToken,
          refreshTokenCookieOptions,
        )
      })
    return Astro.redirect(Astro.url.pathname)
  }
}
const { username, role } =
  userRes.status === 'success' ? (userRes.data as UserData) : {}

const { data: allUsers } = allUserRes as FetchSuccess<UserData[]>

export const prerender = false
---

<Layout
  title="Panel de administración"
  description="Panel de administración de editores, administradores y eventos"
>
  <Header isOnDashboard={true} />
  <section>
    <h1 class="my-8 text-center text-4xl font-bold tracking-wider">
      Hola {username}
    </h1>
    {
      role === 'admin' ? (
        <>
          <h2 class="my-6 text-center text-3xl font-bold">Usuarios</h2>
          {allUserRes.status === 'success' ? (
            <UsersTable users={allUsers} />
          ) : (
            <p>{allUserRes.error.message}</p>
          )}
        </>
      ) : null
    }
    <h2 class="my-8 text-center text-3xl font-bold">Tarjetas</h2>
    <section
      id="cards"
      class="mx-auto flex w-full flex-col items-center justify-center"
    >
      {
        festRes.status === 'success' ? (
          festRes.data.map((fest) => {
            const {
              id_fest,
              img,
              name,
              fest_type,
              description,
              objective,
              init_date,
              end_date,
              address,
              frequency,
            } = fest
            return (
              <article id={id_fest} class="card">
                <img src={img} />
                <h4>{name}</h4>
                <span class="badge">${fest_type}</span>
                <p>{description}</p>
                <h5>Objetivo:</h5>
                <p>{objective}</p>
                <div class="dates">
                  <h5>Horarios</h5>
                  <time datetime={init_date}>
                    {init_date.split('T')[0]}, {init_date.split('T')[1]}
                  </time>
                  -
                  <time datetime={end_date}>
                    {end_date.split('T')[0]}, {end_date.split('T')[1]}
                  </time>
                </div>
                <h5>Lugar de encuentro:</h5>
                <address>{address}</address>
                <span>Frecuencia: {frequency}</span>
              </article>
            )
          })
        ) : festRes.code === 404 ? (
          <div class="flex flex-col items-center">
            <p>{festRes.error.message}</p>
            <p>Agregá una nueva para comenzar a mostrarlas a los usuarios ↴</p>
          </div>
        ) : (
          <p>{festRes.error.message}</p>
        )
      }
      <button
        id="add-new-card"
        class="bg-ule shadow-buttons hover:shadow-on-hover mt-4 border-none px-4 py-2.5 text-base font-bold text-white transition-all hover:scale-105 hover:cursor-pointer hover:bg-[color-mix(in_srgb,var(--color-ule),white_10%)] hover:outline-none"
        >+ Agregar una nueva tarjeta</button
      >
    </section>
  </section>
  <Footer />
</Layout>
