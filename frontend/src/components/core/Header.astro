---
import Ule from '@/assets/ule.svg'

interface Props {
  isOnDashboard?: boolean
}

const { isOnDashboard } = Astro.props
---

<header class="bg-ule flex w-full items-center justify-center gap-8">
  {
    isOnDashboard ? (
      <div class="absolute left-0 mx-8">
        <button
          id="close-session"
          class="shadow-buttons bg-bg-close-session hover:bg-bg-close-session/60 hover:shadow-on-hover focus:bg-bg-close-session/60 focus:shadow-on-hover px-1 py-3 text-[1.1rem] font-bold text-white shadow-[color-mix(in_srgb,var(--color-ule),rgb(97,0,0)_90%)] transition-all outline-none hover:scale-105 hover:cursor-pointer focus:scale-105 focus:cursor-pointer"
        >
          Cerrar sesión
        </button>
      </div>
    ) : null
  }
  <h1
    class="flex flex-col text-3xl font-semibold tracking-wide text-white xl:text-5xl [&>span]:py-2 [&>span]:text-right"
  >
    <span>Usuarios Libres</span>
    <span class="block">de Esquel</span>
  </h1>
  <div class="flex aspect-square items-center justify-center">
    <Ule />
  </div>
</header>

<script>
  const $closeSession = document.querySelector(
    '#close-session',
  ) as HTMLButtonElement

  function handleCloseSession() {
    const confirmation = confirm('¿Querés cerrar la sesión?')
    if (confirmation) {
      fetch('http://localhost:3000/users/logout', { credentials: 'include' })
        .then((res) => res.json())
        .then((data) => {
          const { message } = data
          alert(message)
          setTimeout(() => {
            window.location.reload()
          }, 1000)
        })
        .catch((_) => {
          alert('Ocurrió un error inesperado')
        })
      return
    }
    return
  }

  $closeSession?.addEventListener('click', handleCloseSession)
</script>
