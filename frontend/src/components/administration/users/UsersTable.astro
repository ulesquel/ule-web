---
import type { UserData } from '@/types/types'

interface Props {
  users: UserData[]
}

const { users } = Astro.props
---

<table
  class="shadow-buttons boder mx-auto w-[95%] border-collapse border-[color-mix(in_srgb,var(--color-ule),black_20%)]"
>
  <thead class="bg-ule text-[1.2rem] font-extrabold text-white">
    <tr class="flex [&>th]:my-1 [&>th]:w-full [&>th]:p-1 [&>th]:text-center">
      <th>Id de usuario</th>
      <th>Nombre</th>
      <th>Rol</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    {
      users.map((user) => {
        const { id_user, username, role } = user
        return (
          <tr class="flex items-center transition-colors odd:bg-gray-100 even:bg-amber-50 odd:hover:bg-gray-200 even:hover:bg-amber-100 [&>td]:my-1 [&>td]:w-full [&>td]:p-1 [&>td]:text-center [&>td]:nth-[1]:overflow-hidden [&>td]:nth-[1]:text-ellipsis [&>td]:nth-[1]:whitespace-nowrap">
            <td id={id_user} title={id_user}>
              {id_user}
            </td>
            <td>{username}</td>
            {role === 'admin' ? (
              <td
                data-admin
                class="w-full rounded-sm bg-contain bg-clip-border bg-center bg-no-repeat font-bold capitalize"
              >
                {role}
              </td>
            ) : (
              <td
                data-editor
                class="w-full rounded-sm bg-contain bg-clip-border bg-center bg-no-repeat font-bold text-white capitalize"
              >
                {role}
              </td>
            )}
            <td>
              <div>
                <button>Editar datos</button>
                <button>Eliminar usuario</button>
              </div>
            </td>
          </tr>
        )
      })
    }
  </tbody>
  <tfoot class="bg-white">
    <td class="m-0 flex p-0 text-center">
      <a
        href="/administration/register-user"
        class="bg-ule hover:shadow-on-hover w-full px-2 py-2.5 text-base font-bold text-white transition-all hover:cursor-pointer hover:bg-[color-mix(in_srgb,var(--color-ule),white_10%)] hover:outline-none focus:bg-[color-mix(in_srgb,var(--color-ule),white_10%)]"
      >
        + Agregar nuevo usuario
      </a>
    </td>
  </tfoot>
</table>
