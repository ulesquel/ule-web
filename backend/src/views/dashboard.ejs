<% if (id) { %>
  <!DOCTYPE html>
  <html>
    <head>
      <link rel="stylesheet" href="/styles.css">
      <title>Dashboard</title>
    </head>
    <body>
      <button id="close-session">Cerrar sesión</button>
      <main>
        <h1>
          Hola <%= username %>
        </h1>
        <h2>Usuarios</h2>
        <table>
          <thead>
            <tr>
              <th>Id de usuario</th>
              <th>Nombre</th>
              <th>Rol</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
        <h2>Tarjetas</h2>
        <section id="cards">
        </section>
      </main>
      <script type="module">
        const accessToken = window.localStorage.getItem('accessToken')
        const $tbody = document.querySelector('tbody')
        const $cardsSection = document.querySelector('#cards')
        const $closeSession = document.querySelector('#close-session')

        const [allUsersRes, allFestsRes] = await Promise.all([
          fetch('/users/', {
            headers: {
              'Authorization': `Bearer ${accessToken}`
            },
          }),
          fetch('/fests/')
        ])

        if (allUsersRes.status === 401) {
          const newAccessTokenRes = await fetch('/users/refresh', { method: 'post' })
          const newAccessToken = await newAccessTokenRes.json()
          window.localStorage.setItem('accessToken', newAccessToken.accessToken)
          window.navigation.reload()
        }

        if (allUsersRes.status === 404 || allUsersRes.status === 403) {
          const { message } = await allUsersRes.json()
          $tbody.textContent = message
        }

        const users = await allUsersRes.json()
        users.map(user => {
          $tbody.innerHTML += `
            <tr>
              <td id="${user.id_user}" title="${user.id_user}">${user.id_user}</td>
              <td>${user.username}</td>
              <td>${user.role}</td>
              <td>
                <div>
                  <button>Editar datos</button>  
                  <button>Eliminar usuario</button>  
                </div>  
              </td>
            </tr>
          `
        })

        if (allFestsRes.status === 404) {
          const { message } = await allFestsRes.json()
          $cardsSection.textContent = message
        } else {
          const fests = await allFestsRes.json()
            fests.map(fest => {
                const { id_fest, name, frequency, objective, description, init_date, end_date, address, fest_type, img } = fest
                $cardsSection.innerHTML += `
                <article id="${id_fest}" class="card">
                <img src="${img}" />
                <h4>${name}</h4>
                <span class="badge">${fest_type}</span>
                <p>${description}</p>
                <h5>Objetivo:</h5>
                <p>${objective}</p>
                <div class="dates">
                <h5>Horarios</h5>
                <time datetime="${init_date}">${init_date.split('T')[0]}, ${init_date.split('T')[1]}</time>
                -
                <time datetime="${end_date}">${end_date.split('T')[0]}, ${end_date.split('T')[1]}</time>
                </div>
                <h5>Lugar de encuentro:</h5>
                <address>${address}</address>
                <span>Frecuencia: ${frequency}</span>
                </article>
                `
            })
        }

        $closeSession.addEventListener('click', () => {
          fetch('/users/logout')
            .then(res => res.json())
            .then(data => {
              const { message } = data
              alert(message)
              setTimeout(() => {
                window.location.reload()
              }, 1000)
            })
            .catch(error => {
              const { message } = data.json()
              alert(message)
            })
        })
      </script>
    </body>
  </html>
<% } else { %>
  <h1>Error, no estás autorizado a acceder a esta información</h1>
<% } %>
