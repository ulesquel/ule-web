<% if (id) { %>
  <!DOCTYPE html>
  <html>
    <head>
      <link rel="stylesheet" href="/styles.css">
        <% if (role === 'admin') { %>
          <script type="module" src="/services/admin.js"></script>
        <% } %>
      <title>Dashboard</title>
    </head>
    <body>
      <%- include('components/header.ejs', {isOnDashboard: true}) %>
      <main>
        <h1>
          Hola <%= username %>
        </h1>
        <% if (role === 'admin') { %>
          <h2>Usuarios</h2>
          <table>
            <thead>
            <tr>
              <th>Id de usuario</th>
              <th>Nombre</th>
              <th>Rol</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tfoot>
            <td>
              <button id="add-new-user">+ Agregar nuevo usuario</button>
            </td>
          </tfoot>
          <tbody>
          </tbody>
        </table>
        <h2>Tarjetas</h2>
        <%- include('components/new-user-form.ejs') %>
        <% } %>
        <section id="cards">
        </section>
        <%- include('components/new-card-form.ejs') %>
      </main>
      <script type="module" src="/services/dashboard.js"></script>
    </body>
  </html>
<% } else { %>
  <h1>Error, no estás autorizado a acceder a esta información</h1>
<% } %>
