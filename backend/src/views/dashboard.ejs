<% if (id) { %>
  <!DOCTYPE html>
  <html>
    <head>
      <link rel="stylesheet" href="/styles.css">
      <title>Dashboard</title>
    </head>
    <body>
      <%- include('components/header.ejs', {isOnDashboard: true}) %>
      <main>
        <h1>
          Hola <%= username %>
        </h1>
        <h2>Usuarios</h2>
        <table>
          <thead>
            <tr>
              <th>Id de usuario</th>
              <th>Nombre</th>
              <th>Rol</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tfoot>
            <td>
              <button>+ Agregar nuevo usuario</button>
            </td>
          </tfoot>
          <tbody>
          </tbody>
        </table>
        <h2>Tarjetas</h2>
        <section id="cards">
        </section>
        <%- include('components/new-card-form.ejs') %>
      </main>
      <script type="module">
        const accessToken = window.localStorage.getItem('accessToken')
        const $tbody = document.querySelector('tbody')
        const $cardsSection = document.querySelector('#cards')
        const $closeSession = document.querySelector('#close-session')
        const $addNewCardDialog = document.querySelector('#add-new-card-dialog')

        const [allUsersRes, allFestsRes] = await Promise.all([
          fetch('/users/', {
            headers: {
              'Authorization': `Bearer ${accessToken}`
            },
          }),
          fetch('/fests/')
        ])

        if (allUsersRes.status === 401) {
          const newAccessTokenRes = await fetch('/users/refresh', { method: 'post' })
          const newAccessToken = await newAccessTokenRes.json()
          window.localStorage.setItem('accessToken', newAccessToken.accessToken)
          window.navigation.reload()
        }

        if (allUsersRes.status === 404 || allUsersRes.status === 403) {
          const { message } = await allUsersRes.json()
          $tbody.textContent = message
        }


        const renderUsers = (users) => {
          if (!Array.isArray(users)) {
            $tbody.textContent = 'Usuarios no validos, algo malo ocurrió'
          }

          users.map(user => {
            const { id_user, username, role } = user

            $tbody.innerHTML += `
              <tr>
                <td id="${id_user}" title="${id_user}">${id_user}</td>
                <td>${username}</td>
                <td data-${role}>${role}</td>
                <td>
                  <div>
                    <button>Editar datos</button>  
                    <button>Eliminar usuario</button>  
                  </div>  
                </td>
              </tr>
            `
          })
        }

        const users = await allUsersRes.json()
        renderUsers(users)

        const createAddCardButton = () => {
          const $button = document.createElement('button')
          $button.id = 'add-new-card'
          $button.textContent = '+ Agregar una nueva tarjeta'
          $button.onclick = () => $addNewCardDialog.showModal();

          return $button
        }

        if (allFestsRes.status === 404) {
          const $addNewCardsButton = createAddCardButton()
          const $span = document.createElement('span')
          $span.textContent = 'Agrega una nueva para comenzar a mostrarlas a los usuarios ↴'

          const { message } = await allFestsRes.json()
          $cardsSection.textContent = `${message}`
          $cardsSection.appendChild($span)
          $cardsSection.appendChild($addNewCardsButton)
        } else {
          const fests = await allFestsRes.json()
          fests.map(fest => {
            const { id_fest, name, frequency, objective, description, init_date, end_date, address, fest_type, img } = fest
            $cardsSection.innerHTML += `
            <article id="${id_fest}" class="card">
              <img src="${img}" />
              <h4>${name}</h4>
              <span class="badge">${fest_type}</span>
              <p>${description}</p>
              <h5>Objetivo:</h5>
              <p>${objective}</p>
              <div class="dates">
                <h5>Horarios</h5>
                <time datetime="${init_date}">${init_date.split('T')[0]}, ${init_date.split('T')[1]}</time>
                -
                <time datetime="${end_date}">${end_date.split('T')[0]}, ${end_date.split('T')[1]}</time>
              </div>
              <h5>Lugar de encuentro:</h5>
              <address>${address}</address>
              <span>Frecuencia: ${frequency}</span>
            </article>
            `
          })
        }

        $closeSession.addEventListener('click', () => {
          const confirmation = confirm('¿Querés cerrar la sesión?')
          if (confirmation) {
            fetch('/users/logout')
              .then(res => res.json())
              .then(data => {
                const { message } = data
                alert(message)
                setTimeout(() => {
                  window.location.reload()
                }, 1000)
              })
              .catch(error => {
                const { message } = data.json()
                alert(message)
              })
            return
          }
          return
        })
      </script>
    </body>
  </html>
<% } else { %>
  <h1>Error, no estás autorizado a acceder a esta información</h1>
<% } %>
