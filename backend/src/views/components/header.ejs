<style>
  header {
    background-color: var(--color-ule);
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    position: relative;

    .close-session-container {
      position: absolute;
      left: 0;
      margin-inline: 2rem;

      button {
        border: none;
        padding: .8rem .5rem;
        font-size: 1.1rem;
        background-color: color-mix(in srgb, var(--color-ule), red 50%);
        color: white;
        outline: 0px solid color-mix(in srgb, var(--color-ule), rgb(99, 0, 0) 90%);
        font-weight: 700;
        box-shadow: 3px 3px 0 color-mix(in srgb, var(--color-ule), rgb(97, 0, 0) 90%);
        transition: background-color .1s ease-in-out, outline .1s ease-in-out;

        &:hover {
          background-color: color-mix(in srgb, var(--color-ule), red 30%);
        }

        &:focus, &:active {
          background-color: color-mix(in srgb, var(--color-ule), red 30%);
          outline: 2px solid color-mix(in srgb, var(--color-ule), rgb(99, 0, 0) 90%);
        }
      }
    }

    h1 {
      font-size: clamp(1.875rem, 3rem);
      font-weight: 600;
      letter-spacing: 0.025rem;
      color: white;
      flex-direction: column;
      display: flex;

      span {
        text-align: right;
        padding-block: 0.5rem;

        &:nth-child(2) {
          display: block;
        }
      }
    }

    div {
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: square;

      svg {
        text {
          font-size: 9.92328px;
          writing-mode: lr-tb;
          direction: ltr;
          opacity: 1;
          fill-opacity: 1;
          fill: #fff;
          stroke: #fff;
          stroke-width: 0.699803;
          stroke-linecap: butt;
          stroke-dasharray: none;
          stroke-opacity: 1;
          paint-order: normal;

          tspan {
            font-style: normal;
            font-variant: normal;
            font-weight: 300;
            color: #fff;
            fill: #fff;
            stroke: #fff;
            font-stretch: normal;
            font-family: Ubuntu;
            -inkscape-font-specification: 'Ubuntu Light';
            stroke-width: 0.699803;
            stroke-dasharray: none;
          }
        }
      }
    }
  }
</style>
