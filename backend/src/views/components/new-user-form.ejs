<dialog id="add-new-user-dialog">
  <button id="close-user-dialog">❌</button>
  <h2>Crear nuevo usuario</h2>
  <form id="new-user-form" enctype="multipart/form-data">
    <label>
      Nombre de usuario
      <input type="text" id="username" required />
    </label>
    <label>
      Seleccione el rol
      <select id="role">
        <option value="editor">Editor</option>
        <option value="admin">Administrador</option>
      </select>
    </label>
    <label>
      Contraseña
      <input type="password" id="password" required
    /></label>
    <label>
      Confirme la contraseña
      <input type="password" id="confirm-password" required
    /></label>
    <div class="card-form-actions">
      <button type="reset" id="cancel-create-user">Cancelar</button>
      <button type="submit" id="save-user">+ Guardar nuevo usuario</button>
    </div>
  </form>
</dialog>

<script type="module">
  const $closeUserDialog = document.querySelector('#close-user-dialog')
  const $addNewUserDialog = document.querySelector('#add-new-user-dialog')
  const $cancelCreateUser = document.querySelector('#cancel-create-user')
  const $saveUser = document.querySelector('#save-user')
  // Form fields
  const $username = document.querySelector('#username')
  const $role = document.querySelector('#role')
  const $password = document.querySelector('#password')
  const $confirmPassword = document.querySelector('#confirm-password')

  $cancelCreateUser.addEventListener('click', () => $addNewUserDialog.close())
  $closeUserDialog.addEventListener('click', () => $addNewUserDialog.close())

  $saveUser.addEventListener('click', async (e) => {
    e.preventDefault()

    const { username, role, password, confirmPassword } = {
      username: $username.value,
      role: $role.value,
      password: $password.value,
      confirmPassword: $confirmPassword.value,
    }

    if (!username || !password || !confirmPassword)
      return alert('No deje los campos vacíos')

    if (password !== confirmPassword)
      return alert('Las contraseñas deben coincidir')

    const body = { username, role, password }

    const res = await fetch('/users/register', {
      method: 'post',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(body),
    })

    const { message } = await res.json()
    return alert(message)
  })
</script>
