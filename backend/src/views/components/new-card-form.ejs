<dialog id="add-new-card-dialog">
  <button id="close-card-dialog">❌</button>
  <h2>Crear nueva tarjeta</h2>
  <form id="new-card-form" enctype="multipart/form-data">
    <label>
      Nombre
      <input type="text" id="name" />
    </label>
    <div>
      <label>
        Frecuencia
        <select id="frequency"></select>
      </label>
      <label>
        Tipo de evento
        <select id="fest_type"></select>
      </label>
    </div>
    <label>
      Objetivo
      <textarea id="objective"></textarea>
    </label>
    <label>
      Descripción
      <textarea id="description"></textarea>
    </label>
    <div>
      <label>
        Fecha de inicio
        <input type="date" id="init_date" />
      </label>
      <label>
        Fecha de fin
        <input type="date" id="end_date" />
      </label>
    </div>
    <label>
      Dirección
      <input type="text" id="address" />
    </label>
    <label>
      Imagen
      <input type="file" id="img" />
    </label>
    <div class="card-form-actions">
      <button type="reset" id="cancel-create-card">Cancelar</button>
      <button type="submit" id="save-card">+ Guardar nueva tarjeta</button>
    </div>
  </form>
</dialog>

<script type="module">
  export const frequencies = {
    daily: 'Diario',
    weekly: 'Semanal',
    biweekly: 'Bi-semanal',
    monthly: 'Mensual',
  }

  export const festTypes = {
    competition: 'Competencia',
    event: 'Evento',
    workshop: 'Taller',
  }

  const $addNewCardDialog = document.querySelector('#add-new-card-dialog')
  const $closeCardDialog = document.querySelector('#close-card-dialog')
  const $name = document.querySelector('#name')
  const $frequency = document.querySelector('#frequency')
  const $festType = document.querySelector('#fest_type')
  const $objective = document.querySelector('#objective')
  const $description = document.querySelector('#description')
  const $initDate = document.querySelector('#init_date')
  const $endDate = document.querySelector('#end_date')
  const $address = document.querySelector('#address')
  const $img = document.querySelector('#img')
  const $cancelCreateCard = document.querySelector('#cancel-create-card')

  Object.keys(frequencies).forEach((freq) => {
    $frequency.innerHTML += `<option id="${freq}" value="${freq}">${frequencies[freq]}</option>`
  })

  Object.keys(festTypes).forEach((fest) => {
    $festType.innerHTML += `<option id="${fest}" value="${fest}">${festTypes[fest]}</option>`
  })

  $cancelCreateCard.addEventListener('click', () => $addNewCardDialog.close())
  $closeCardDialog.addEventListener('click', () => $addNewCardDialog.close())
</script>
